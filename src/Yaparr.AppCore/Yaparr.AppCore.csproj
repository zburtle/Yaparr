<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the desktop and Android apps share and that has no window in it: where the profile lives and what is in it,
       the read marks, links, picture preparation and the microphone and speakers for a voice call. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaparr.AppCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yaparr.Desktop" />
    <InternalsVisibleTo Include="Yaparr.Android" />
    <InternalsVisibleTo Include="Yaparr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yaparr\Yaparr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>

</Project>
