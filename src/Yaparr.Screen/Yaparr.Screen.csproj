<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaparr.Screen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yaparr\Yaparr.csproj" />
    <!-- Talks to the desktop's ScreenCast portal over D-Bus, which is how Wayland lets a program share the screen (MIT licence). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <!-- Capturing, encoding and decoding are done by FFmpeg, run as a separate program (see FfmpegLocator): nothing of FFmpeg is
       linked into Yaparr, which keeps its licence apart from Yaparr's own. -->

</Project>
