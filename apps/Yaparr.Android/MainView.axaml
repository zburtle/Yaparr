<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Yaparr.AndroidApp"
             x:Class="Yaparr.AndroidApp.MainView"
             x:DataType="local:MainView">
    <Grid x:Name="Root" Background="{DynamicResource AppBg}">

        <!-- First start, step 1: has this person used Yaparr before? Someone who has brings their account here instead of making a new one. -->
        <ScrollViewer x:Name="WelcomePanel">
            <StackPanel Margin="20,56,20,24" Spacing="12" MaxWidth="480">
                <TextBlock Text="Welcome to Yaparr" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="Chat and voice with no server. Make a room and send its invite to the people you want in it."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <TextBlock Text="Have you used Yaparr before?" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,4" Foreground="{DynamicResource Ink}" />
                <Button x:Name="NewHereButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14" Click="NewHereClicked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="No, I'm new here" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Make a new account on this phone." FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="HaveAccountButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14" Click="HaveAccountClicked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Yes, I already have an account" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Bring it to this phone, from your computer or from a backup. People then see you as one person." FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Step 2 for someone new: the name people see next to the messages. -->
        <ScrollViewer x:Name="NamePanel" IsVisible="False">
            <StackPanel Margin="20,56,20,24" Spacing="12" MaxWidth="480">
                <TextBlock Text="What should people call you?" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="This is the name others see next to your messages. You can change it later in Settings."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <TextBox x:Name="NameBox" MaxLength="40" Margin="0,12,0,0" PlaceholderText="Your name" />
                <Button x:Name="StartButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="StartClicked" Content="Continue" />
                <TextBlock x:Name="StartStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button x:Name="NameBackButton" Content="Back" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="WelcomeBackClicked" />
            </StackPanel>
        </ScrollViewer>

        <!-- Step 2 for someone who has used Yaparr: where the account is now. -->
        <ScrollViewer x:Name="ExistingPanel" IsVisible="False">
            <StackPanel Margin="20,56,20,24" Spacing="12" MaxWidth="480">
                <TextBlock Text="Bring your account here" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="Your name, your rooms and the people you blocked come with it. Where is your account now?"
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button x:Name="LinkStartButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14" Margin="0,12,0,0" Click="LinkStartClicked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="On my computer" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Link this phone to it by scanning a QR code. Both stay signed in as you." FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreStartButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,14" Click="RestoreClicked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="In a backup file" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Use a backup made in Settings, Backup. For a new phone; if your old one is still in use, link instead." FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ExistingStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button Content="Back" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="WelcomeBackClicked" />
            </StackPanel>
        </ScrollViewer>

        <!-- Taking an account over from a computer: scan its QR code, or paste the code and passphrase. -->
        <ScrollViewer x:Name="LinkPanel" IsVisible="False">
            <StackPanel Margin="20,56,20,24" Spacing="12" MaxWidth="480">
                <TextBlock Text="Link with your computer" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
                <TextBlock Text="On the computer, open Settings, Devices, Link another device, and choose Show a QR code. Then scan it here."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button x:Name="ScanButton" Classes="primary" HorizontalAlignment="Stretch" Content="Scan the QR code" Click="ScanClicked" />
                <TextBlock Text="Or paste the code and its passphrase" Margin="0,12,0,0" Foreground="{DynamicResource Muted}" />
                <TextBox x:Name="CodeBox" PlaceholderText="Link code" TextWrapping="Wrap" MaxHeight="120" />
                <TextBox x:Name="PassphraseBox" PlaceholderText="Passphrase, like K7QD-M3XF-9PLR-2WTE-HV8N" />
                <Button x:Name="LinkButton" HorizontalAlignment="Stretch" Content="Link" Click="LinkClicked" />
                <TextBlock x:Name="LinkStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <Button Content="Back" HorizontalAlignment="Stretch" Click="LinkBackClicked" />
            </StackPanel>
        </ScrollViewer>

        <!-- The rooms and direct chats, the one with the newest message first. -->
        <Grid x:Name="ListPanel" IsVisible="False" RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,44,8,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="Yaparr" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
                    <Button Grid.Column="1" Content="Settings" FontSize="13" Padding="10,6" Background="Transparent" Foreground="{DynamicResource Muted}"
                            Click="SettingsClicked" />
                    <Button Grid.Column="2" Content="+" FontSize="22" Padding="16,2" Background="Transparent" Foreground="{DynamicResource Accent}"
                            Click="AddClicked" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1">
                <Border x:Name="SyncBanner" IsVisible="False" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="SyncText" Margin="16,8" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Accent}" />
                        <ProgressBar x:Name="SyncBar" Height="3" MinHeight="3" IsIndeterminate="True" Maximum="1" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ListStatus" Margin="16,8" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" />
            </StackPanel>
            <Grid Grid.Row="2">
                <ListBox x:Name="ChatList" Background="Transparent" SelectionChanged="ChatSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:Chat">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                                <Border Width="46" Height="46" CornerRadius="23" Background="{Binding Tint}">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" />
                                    <TextBlock Text="{Binding Preview}" IsVisible="{Binding ShowPreview}" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="{Binding SyncText}" IsVisible="{Binding HasSyncText}" FontSize="13" MaxLines="1" Foreground="{DynamicResource Accent}" />
                                    <ProgressBar IsVisible="{Binding IsSyncing}" IsIndeterminate="True" Height="2" MinHeight="2" MinWidth="0" Width="64" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Border Grid.Column="2" IsVisible="{Binding HasUnread}" Background="{DynamicResource Accent}" CornerRadius="12"
                                        MinWidth="24" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="No rooms yet. Tap + to make one, or to join one with an invite."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="32" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" IsVisible="False" />
            </Grid>
        </Grid>

        <!-- Settings: who you are, how the app looks, and the microphone. -->
        <Grid x:Name="SettingsPanel" IsVisible="False" RowDefinitions="Auto,*">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="4,44,8,10">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Content="‹" FontSize="26" Padding="14,0" Background="Transparent" Foreground="{DynamicResource Accent}" Click="SettingsBackClicked" />
                    <TextBlock Grid.Column="1" Text="Settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="16,12,16,32" Spacing="10" MaxWidth="520">
                    <TextBlock Text="You" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="Your name, as people see it. It changes on your other devices too." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Muted}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SettingsName" MaxLength="40" />
                        <Button Grid.Column="1" Classes="primary" Content="Save" Click="SaveNameClicked" />
                    </Grid>
                    <TextBlock x:Name="SettingsNote" FontSize="12" Foreground="{DynamicResource Accent}" />

                    <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button x:Name="ThemeSystem" Content="System" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeClicked" Tag="System" />
                        <Button x:Name="ThemeLight" Grid.Column="1" Content="Light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeClicked" Tag="Light" />
                        <Button x:Name="ThemeDark" Grid.Column="2" Content="Dark" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ThemeClicked" Tag="Dark" />
                    </Grid>

                    <TextBlock Text="Voice" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <CheckBox x:Name="AlwaysOnCheck" Content="Send all the time, not only when I talk" Click="VoiceSettingChanged" />
                    <StackPanel>
                        <TextBlock Text="Microphone sensitivity (how loud you have to be to be heard)" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Ink}" />
                        <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="60" ValueChanged="VoiceSliderChanged" PointerCaptureLost="VoiceSliderReleased" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Everyone's volume" FontSize="13" Foreground="{DynamicResource Ink}" />
                        <Slider x:Name="VolumeSlider" Minimum="50" Maximum="300" ValueChanged="VoiceSliderChanged" PointerCaptureLost="VoiceSliderReleased" />
                    </StackPanel>
                    <CheckBox x:Name="AutoVolumeCheck" Content="Even out my microphone (raise a quiet one, lower a loud one)" Click="VoiceSettingChanged" />
                    <TextBlock Text="Echo and noise are taken out by Android itself, as in a phone call." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />

                    <TextBlock Text="Network" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="Looks at how this phone can be reached and why connecting to someone may fail." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Muted}" />
                    <Button HorizontalAlignment="Stretch" Content="Check the connection" Click="NetworkClicked" />

                    <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <CheckBox x:Name="NotifyCheck" Content="Notify me of messages" Click="NotificationSettingChanged" />
                    <TextBlock Text="Direct messages, mentions and replies to you. In a room's menu you can turn on every message. The lock screen shows who wrote and where, never the words." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <CheckBox x:Name="BackgroundCheck" Content="Stay connected in the background" Click="NotificationSettingChanged" />
                    <TextBlock x:Name="BackgroundNote" Text="Keeps Yaparr connected when you leave it, so messages arrive and notify. Android shows a notification while it is on, and it uses some battery." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <Button HorizontalAlignment="Stretch" Content="Send a test notification" Click="TestNotificationClicked" />
                    <Button x:Name="BatteryButton" HorizontalAlignment="Stretch" Content="Let Yaparr run in the background" Click="BatteryClicked" />
                    <TextBlock x:Name="NotificationNote" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />

                    <TextBlock Text="Link previews" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <CheckBox x:Name="LinkPreviewCheck" Content="Show a preview under the links I send" Click="LinkPreviewChanged" />
                    <TextBlock Text="When you send a web link, this phone reads the page's title, description and picture and sends them with the message. The people who read it never contact the site, so it does not see their address, but it does see yours. Turn this off to send only the link." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />

                    <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="A backup is a copy of your account, room keys and message history, to bring back on a new phone if you lose this one." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Muted}" />
                    <Button HorizontalAlignment="Stretch" Content="Back up this phone's account" Click="BackupClicked" />

                    <TextBlock Text="About" FontWeight="SemiBold" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource Ink}" />
                    <Button HorizontalAlignment="Stretch" Content="Copy what this phone is connected to" Click="DiagnosticsClicked" />
                    <TextBlock Text="Copies who this phone is connected to and what it has been doing, for a report of a problem." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- One room or direct chat: the messages, and a box to write in. -->
        <Grid x:Name="ChatPanel" x:DataType="local:Chat" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="4,44,4,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Content="‹" FontSize="26" Padding="14,0" Background="Transparent" Foreground="{DynamicResource Accent}" Click="BackClicked" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}" />
                        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <Button x:Name="MenuButton" Grid.Column="2" Content="⋮" FontSize="22" Padding="16,0" Background="Transparent" Foreground="{DynamicResource Ink}" />
                </Grid>
            </Border>

            <!-- Voice: join the room's voice channel; in it, who is there, and mute, deafen, speaker and leave. -->
            <Border IsVisible="{Binding IsRoom}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding VoiceChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:VoiceChannelVm">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" />
                                        <TextBlock Text="{Binding MembersText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Content="Join voice" Padding="14,6" IsVisible="{Binding CanJoin}" Click="JoinVoiceClicked" />
                                    <TextBlock Grid.Column="1" Text="You're here" IsVisible="{Binding InCall}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding VoiceMembers}" IsVisible="{Binding HasVoiceMembers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:VoiceMember">
                                <Border Background="{Binding Fill}" CornerRadius="14" Padding="10,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{Binding Ink}" />
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding Ink}" Opacity="0.7" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" IsVisible="{Binding InVoice}">
                        <Button Content="{Binding MuteLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" Click="MuteClicked" />
                        <Button Grid.Column="1" Content="{Binding DeafenLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" Click="DeafenClicked" />
                        <Button Grid.Column="2" Content="{Binding RouteLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" Click="RouteClicked" />
                        <Button Grid.Column="3" Content="Leave" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" Foreground="{DynamicResource Bad}" Click="LeaveVoiceClicked" />
                    </Grid>
                    <Button Content="Soundboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" IsVisible="{Binding InVoice}" Click="SoundboardClicked" />
                    <Button Content="Share my screen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" IsVisible="{Binding CanShareScreen}" Click="ShareScreenClicked" />
                    <TextBlock Text="{Binding ShareHint}" IsVisible="{Binding ShowShareHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                    <Button Content="Stop sharing my screen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" Foreground="{DynamicResource Bad}" IsVisible="{Binding IsSharing}" Click="StopShareClicked" />
                    <ItemsControl ItemsSource="{Binding Shares}" IsVisible="{Binding HasShares}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ShareItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
                                    <Button Grid.Column="1" Classes="primary" Content="Watch" Padding="14,6" IsVisible="{Binding !IsMine}" Click="WatchClicked" />
                                    <TextBlock Grid.Column="1" Text="Yours" IsVisible="{Binding IsMine}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding ShowChannels}">
                <ItemsControl ItemsSource="{Binding Channels}" Margin="8,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelChip">
                            <Button Content="{Binding Label}" Background="{Binding Fill}" Foreground="{Binding Ink}" Padding="14,6" CornerRadius="16"
                                    Click="ChannelClicked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ListBox x:Name="Messages" Grid.Row="2" Background="Transparent" Padding="8,8" ItemsSource="{Binding Shown}">
                <!-- A message is not "picked" from the list (a press does something: a long press opens the actions, a tap on an emoji reacts), so the list's own highlight
                     of the row under a finger, or of the one just pressed, is switched off. -->
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:Line">
                        <StackPanel>
                        <Border HorizontalAlignment="{Binding Align}" MaxWidth="320" Padding="12,8" CornerRadius="16" Background="{Binding Fill}" Holding="MessageHeld">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Who}" FontSize="11" FontWeight="SemiBold" Opacity="0.75"
                                           Foreground="{Binding Ink}" IsVisible="{Binding !Mine}" />
                                <Border IsVisible="{Binding HasReply}" Background="#22000000" CornerRadius="8" Padding="8,4" Tapped="QuoteTapped">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReplyWho}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Ink}" />
                                        <TextBlock Text="{Binding ReplyText}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" Opacity="0.8" />
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding HasAttachment}" CornerRadius="10" ClipToBounds="True" Tapped="PictureTapped" Background="Transparent">
                                    <StackPanel Spacing="4">
                                        <local:AnimatedImage Source="{Binding Picture}" Animation="{Binding Animation}" IsVisible="{Binding HasPicture}" MaxWidth="260" MaxHeight="340" Stretch="Uniform" />
                                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasPictureStatus}" MaxWidth="260" MaxHeight="200" Stretch="Uniform" Opacity="0.6" />
                                        <TextBlock Text="{Binding PictureStatus}" IsVisible="{Binding HasPictureStatus}" FontSize="12" Foreground="{Binding Ink}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding Ink}" IsVisible="{Binding HasText}" />
                                <Border IsVisible="{Binding HasCard}" Background="#22000000" CornerRadius="8" Padding="8" Margin="0,2,0,0" Tapped="CardTapped">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Image Source="{Binding CardImage}" IsVisible="{Binding HasCardImage}" Width="56" Height="56" Margin="0,0,8,0" Stretch="UniformToFill" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding CardHost}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" />
                                            <TextBlock Text="{Binding CardTitle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" />
                                            <TextBlock Text="{Binding CardDescription}" IsVisible="{Binding HasCardDescription}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" Foreground="{Binding Ink}" />
                            </StackPanel>
                        </Border>
                            <ItemsControl ItemsSource="{Binding Reactions}" IsVisible="{Binding HasReactions}" HorizontalAlignment="{Binding Align}" MaxWidth="324" Margin="-2,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReactionChip">
                                        <Border Background="{Binding Fill}" BorderBrush="{Binding Edge}" BorderThickness="1" CornerRadius="12" Margin="2" Tapped="ReactionChipTapped">
                                            <Panel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,3" IsVisible="{Binding ShowEmoji}">
                                                    <TextBlock Text="{Binding Emoji}" FontSize="15" FontFamily="Roboto" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CountText}" IsVisible="{Binding ShowCount}" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Ink}" />
                                                </StackPanel>
                                                <Border Width="22" Height="22" Margin="0,3" CornerRadius="11" Background="#99C8C8C8" IsVisible="{Binding IsAdd}">
                                                    <TextBlock Text="+" FontSize="17" FontWeight="Bold" Foreground="#E6333333" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3">
            <Border x:Name="ReplyBar" IsVisible="False" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock x:Name="ReplyBarTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="ReplyBarText" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{DynamicResource Muted}" Click="CancelReplyClicked" />
                </Grid>
            </Border>
            <Border x:Name="MentionBar" IsVisible="False" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="8,6">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="MentionList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:Person">
                                <Button Content="{Binding Name}" Padding="14,6" CornerRadius="16" Click="MentionChosen" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
                    <Button Padding="14,0" Background="Transparent" Foreground="{DynamicResource Accent}" Click="AttachClicked">
                        <!-- The plus sits low in its line, so it is lifted to line up with the middle of the capitals of GIF beside it. -->
                        <TextBlock Text="+" FontSize="22" Margin="0,-3,0,0" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1" Content="GIF" FontSize="13" FontWeight="SemiBold" Padding="8,0" Background="Transparent" Foreground="{DynamicResource Accent}" Click="ShelfClicked" />
                    <TextBox x:Name="InputBox" Grid.Column="2" PlaceholderText="Message" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" TextChanged="InputChanged" />
                    <Button Grid.Column="3" Classes="primary" Content="Send" Click="SendClicked" />
                </Grid>
            </Border>
            </StackPanel>
        </Grid>

        <!-- Make or join a room, or write to a person. -->
        <Border x:Name="AddPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <ScrollViewer VerticalAlignment="Center">
                <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Rooms" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                        <TextBox x:Name="RoomNameBox" PlaceholderText="Room name" MaxLength="40" />
                        <TextBox x:Name="RoomInviteBox" PlaceholderText="Invite (empty makes a new room)" />
                        <Button Classes="primary" HorizontalAlignment="Stretch" Content="Make or join the room" Click="RoomGoClicked" />
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,6" />
                        <TextBlock Text="Message a person" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                        <TextBox x:Name="PersonBox" PlaceholderText="Their ID (64 characters)" />
                        <Button HorizontalAlignment="Stretch" Content="Open the chat" Click="PersonGoClicked" />
                        <TextBlock x:Name="AddStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                        <Button HorizontalAlignment="Stretch" Content="Close" Click="AddCloseClicked" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- The people of the open room: tap one to write to them. -->
        <!-- Watching a screen someone shares: the picture is drawn by the phone's video decoder on a native surface. -->
        <Border x:Name="WatchPanel" IsVisible="False" Background="Black">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="WatchTitle" Margin="16,56,16,10" FontWeight="SemiBold" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis" />
                <Grid x:Name="WatchArea" Grid.Row="1">
                    <local:ScreenSurfaceHost x:Name="WatchHost" HorizontalAlignment="Center" VerticalAlignment="Center" Width="2" Height="2" />
                    <TextBlock x:Name="WatchStatus" Text="Waiting for the picture&#8230;" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                </Grid>
                <Button Grid.Row="2" Content="Stop watching" Margin="16,10,16,24" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,12" Background="#33FFFFFF" Foreground="White" Click="WatchStopClicked" />
            </Grid>
        </Border>

        <!-- Sharing the screen: what quality, and whether the sound goes too; then Android asks what to share. -->
        <Border x:Name="SharePanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Share my screen" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Quality" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <StackPanel x:Name="ShareQualityList" />
                    <TextBlock x:Name="ShareHintText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <CheckBox x:Name="ShareSoundCheck" Content="Share the sound of the app too" IsChecked="True" />
                    <TextBlock Text="Next, Android asks what to share. Choose one app to keep notifications and other apps out of the picture." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Classes="primary" Content="Choose what to share" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ShareGoClicked" />
                        <Button Grid.Column="1" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ShareCancelClicked" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reacting to a message: the quick emoji, and a search through all of them. -->
        <Border x:Name="ReactPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="16" Padding="12" MaxWidth="440" VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Text="React" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <WrapPanel x:Name="ReactQuick" HorizontalAlignment="Center" />
                    <TextBox x:Name="ReactSearch" PlaceholderText="Search emoji" MaxLength="40" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ReactTabs" Orientation="Horizontal" />
                    </ScrollViewer>
                    <TextBlock x:Name="ReactTitle" FontSize="12" Foreground="{DynamicResource Muted}" />
                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="ReactGrid" />
                    </ScrollViewer>
                    <Button Content="Close" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ReactCloseClicked" />
                </StackPanel>
            </Border>
        </Border>

        <!-- The GIF shelf: pictures kept on this phone to send again with one tap. -->
        <Border x:Name="ShelfPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center" MaxHeight="620">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="GIF shelf" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                        <Button x:Name="ShelfMineTab" Grid.Column="1" Content="Mine" Classes="primary" Padding="12,6" Click="ShelfMineClicked" />
                        <Button x:Name="ShelfRoomTab" Grid.Column="2" Content="This room" Padding="12,6" Click="ShelfRoomClicked" />
                    </Grid>
                    <TextBlock x:Name="ShelfHint" Grid.Row="1" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Muted}" />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="ShelfGrid" /></ScrollViewer>
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ShelfAddButton" Content="Add a picture" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ShelfAddClicked" />
                        <Button Grid.Column="1" Content="Close" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ShelfCloseClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- What can be done with a message: a small window in the middle. -->
        <Border x:Name="ActionPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="40" Padding="8" MaxWidth="320" VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ActionTitle" FontSize="13" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="12,8,12,6" Foreground="{DynamicResource Muted}" />
                    <StackPanel x:Name="ActionList" />
                </StackPanel>
            </Border>
        </Border>

        <!-- A picture, big. -->
        <Border x:Name="PicturePanel" IsVisible="False" Background="#FF0B0B0B">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,44,12,8">
                    <Button Content="Close" Foreground="White" Background="Transparent" Click="PictureCloseClicked" />
                    <Button Grid.Column="2" Content="Save" Foreground="White" Background="Transparent" Click="PictureSaveClicked" />
                </Grid>
                <local:AnimatedImage x:Name="BigPicture" Grid.Row="1" Stretch="Uniform" Margin="0,0,0,24" />
            </Grid>
        </Border>

        <!-- Where the sound of a call goes: a small window in the middle, one line for each place it can go. -->
        <Border x:Name="RoutePanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="40" Padding="8" MaxWidth="320"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <StackPanel Spacing="2">
                    <TextBlock Text="Play the call on" FontWeight="SemiBold" FontSize="16" Margin="12,8,12,6" Foreground="{DynamicResource Ink}" />
                    <StackPanel x:Name="RouteList" />
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="PeoplePanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center" MaxHeight="520">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="People" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <ListBox x:Name="PeopleList" Grid.Row="1" Background="Transparent" SelectionChanged="PersonSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:Person">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" Padding="6,10" FontSize="16" Foreground="{DynamicResource Ink}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Role}" Padding="6,10" FontSize="13" Foreground="{DynamicResource Accent}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Content="Close" Click="PeopleCloseClicked" />
                </Grid>
            </Border>
        </Border>

        <!-- The room's soundboard: play a sound into the call, add one, remove one. -->
        <Border x:Name="SoundPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center" MaxHeight="620">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Soundboard" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <CheckBox x:Name="SilenceCheck" Grid.Row="1" Content="Silence everybody's sounds for me" Click="SilenceClicked" />
                    <ScrollViewer Grid.Row="2"><StackPanel x:Name="SoundList" Spacing="6" /></ScrollViewer>
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Content="Add a sound" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="AddSoundClicked" />
                        <Button Grid.Column="1" Content="Close" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="SoundCloseClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- A line of text to answer. -->
        <Border x:Name="PromptPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PromptTitle" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBox x:Name="PromptBox" MaxLength="40" />
                    <Button Classes="primary" HorizontalAlignment="Stretch" Content="Save" Click="PromptOkClicked" />
                    <Button HorizontalAlignment="Stretch" Content="Cancel" Click="PromptCancelClicked" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Who you have blocked, and who is banned from this room. -->
        <Border x:Name="BlockedPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center" MaxHeight="560">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Blocked and banned" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <ScrollViewer Grid.Row="1"><StackPanel x:Name="BlockedList" Spacing="2" /></ScrollViewer>
                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Content="Close" Click="BlockedCloseClicked" />
                </Grid>
            </Border>
        </Border>

        <!-- The connection check. -->
        <Border x:Name="NetworkPanel" IsVisible="False" Background="#99000000" PointerPressed="OverlayBackdropPressed">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center" MaxHeight="640">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="Connection check" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="NetworkSummary" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                    <ScrollViewer Grid.Row="2"><StackPanel x:Name="NetworkList" Spacing="10" /></ScrollViewer>
                    <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button x:Name="NetworkAgain" Content="Again" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="NetworkAgainClicked" />
                        <Button x:Name="NetworkCopy" Grid.Column="1" Content="Copy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="NetworkCopyClicked" />
                        <Button Grid.Column="2" Content="Close" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="NetworkCloseClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- A question with two answers. -->
        <Border x:Name="ConfirmPanel" IsVisible="False" Background="#99000000">
            <Border Background="{DynamicResource Surface}" CornerRadius="16" Margin="20" Padding="16" MaxWidth="440" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                    <Button x:Name="ConfirmYes" Classes="primary" HorizontalAlignment="Stretch" Click="ConfirmYesClicked" />
                    <Button HorizontalAlignment="Stretch" Content="Cancel" Click="ConfirmNoClicked" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
