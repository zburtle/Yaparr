<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not Yaparr.Android: inside that namespace, "Android.App" would stop meaning the platform's. -->
    <RootNamespace>Yaparr.AndroidApp</RootNamespace>
    <AssemblyName>Yaparr.Android</AssemblyName>
    <ApplicationId>org.yaparr.android</ApplicationId>
    <!-- Each build needs a higher number than the one installed, or Android will not update over it. CI passes the run number. -->
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>Yaparr</Product>
    <Company>Yaparr</Company>
  </PropertyGroup>

  <!--
    Every build is signed with the same key, so one build installs over the last instead of having to be uninstalled first (Android
    refuses an update signed with a different key, and without this each machine makes a key of its own). This key is only for builds
    that are tried on a phone: it is in the repository, so it proves nothing about who made a package. A release has to be signed with a
    key kept secret, passed on the command line (those properties win over these).
  -->
  <PropertyGroup>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>yaparr-debug.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>android</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>yaparr-debug</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaparr\Yaparr.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.AppCore\Yaparr.AppCore.csproj" />
    <!-- The stream formats and codec facts of a shared screen (H.264 and VP8 frames, the names of the sound streams). Nothing is captured or decoded with FFmpeg on the phone. -->
    <ProjectReference Include="..\..\src\Yaparr.Screen\Yaparr.Screen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Android" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Scanning the QR code: the phone's camera through CameraX (AndroidX, not Google Play services) and ZXing to read it. -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

</Project>
