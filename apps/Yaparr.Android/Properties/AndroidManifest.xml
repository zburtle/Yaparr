<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.yaparr.android">
  <!-- Push notifications through UnifiedPush: Android only lets an app see the distributor apps (ntfy and others) it asks about here. -->
  <queries>
    <intent>
      <action android:name="org.unifiedpush.android.distributor.REGISTER" />
    </intent>
  </queries>
</manifest>
