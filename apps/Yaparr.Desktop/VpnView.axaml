<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Yaparr.Desktop"
             x:Class="Yaparr.Desktop.VpnView">
    <StackPanel Spacing="4">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Send Yaparr's own traffic through a WireGuard VPN." />
                   <local:LearnMoreLink Topic="vpn" Text="Learn more about the VPN" Foreground="{DynamicResource Accent}" />
        <TextBlock x:Name="ConfigText" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock x:Name="NetworkText" TextWrapping="Wrap" Foreground="Gray" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ImportButton" Content="Import config…" Click="Import_Click" />
            <Button x:Name="ToggleButton" Content="Connect" Classes="primary" MinWidth="90" HorizontalContentAlignment="Center" Click="Toggle_Click" />
            <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
