<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaparr.Desktop</RootNamespace>
    <AssemblyName>Yaparr.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\logo\yaparr.ico</ApplicationIcon>
    <Product>Yaparr</Product>
    <Company>Yaparr</Company>
    <Copyright>Copyright (C) 2026 Zach Burtle. Licensed under the GNU General Public License, version 3 or later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="Yaparr.Tests" />
  </ItemGroup>

  <!-- The licence texts travel with the app (the MSI takes the whole publish folder, the .deb copies them too). -->
  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\COPYING" Link="COPYING" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES-SkiaSharp.txt" Link="THIRD-PARTY-NOTICES-SkiaSharp.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\logo\png\yaparr-256.png" Link="Assets\yaparr.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Yaparr.AppCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaparr\Yaparr.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.AppCore\Yaparr.AppCore.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.Voice.WebRtc\Yaparr.Voice.WebRtc.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.Screen\Yaparr.Screen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <PackageReference Include="NLayer" Version="3.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>

</Project>
