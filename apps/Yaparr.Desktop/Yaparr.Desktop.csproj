<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaparr.Desktop</RootNamespace>
    <AssemblyName>Yaparr.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\logo\yaparr.ico</ApplicationIcon>
    <Product>Yaparr</Product>
    <Company>Yaparr</Company>
    <Copyright>Copyright (C) 2026 Zach Burtle. Licensed under the GNU General Public License, version 3 or later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="Yaparr.Tests" />
  </ItemGroup>

  <!-- The licence texts travel with the app (the MSI takes the whole publish folder, the .deb copies them too). -->
  <ItemGroup>
    <!-- What this release is offered with (the backup server's address): the published folder carries it into the installer, the Flatpak and the .deb. -->
    <None Include="yaparr.release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\COPYING" Link="COPYING" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES-SkiaSharp.txt" Link="THIRD-PARTY-NOTICES-SkiaSharp.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- For trying the in-process encoder (the "in-process encoder" launch profile sets YAPARR_INPROCESS=1): FFmpeg's shared libraries, fetched by
       tools\Get-FfmpegLibs.ps1 into artifacts\ffmpeg-libs, are copied next to the program in an "ffmpeg" folder, in Debug builds only. Nothing is shipped from this. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\..\artifacts\ffmpeg-libs')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\ffmpeg-libs\*.dll" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\logo\png\yaparr-256.png" Link="Assets\yaparr.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Yaparr.AppCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaparr\Yaparr.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.AppCore\Yaparr.AppCore.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.Voice.WebRtc\Yaparr.Voice.WebRtc.csproj" />
    <ProjectReference Include="..\..\src\Yaparr.Screen\Yaparr.Screen.csproj" />
  </ItemGroup>

  <!-- Windows toasts with a box to type a reply into (see WindowsPopups): a Windows-only library, built beside the program on Windows and copied next to it (and into the
       published folder, which is what the installer takes), then loaded when the first pop-up is shown. Not referenced as a library, so this program stays one for every
       system; on another system none of this is built or copied, and the plain pop-up is used. -->
  <PropertyGroup>
    <WindowsToastProject>$(MSBuildThisFileDirectory)..\..\src\Yaparr.WindowsToast\Yaparr.WindowsToast.csproj</WindowsToastProject>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\src\Yaparr.WindowsToast\Yaparr.WindowsToast.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>
  <Target Name="IncludeWindowsToast" AfterTargets="ResolveProjectReferences" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeResolvedFilesToPublishList" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <WindowsToastOutput>$(MSBuildThisFileDirectory)..\..\src\Yaparr.WindowsToast\bin\$(Configuration)\net10.0-windows10.0.19041.0\</WindowsToastOutput>
    </PropertyGroup>
    <ItemGroup>
      <!-- Only what is its own: the library, the toolkit, and the Windows projection with its runtime (the rest it shares with this program). -->
      <WindowsToastFile Include="$(WindowsToastOutput)Yaparr.WindowsToast.dll;$(WindowsToastOutput)CommunityToolkit.WinUI.Notifications.dll;$(WindowsToastOutput)Microsoft.Windows.SDK.NET.dll;$(WindowsToastOutput)WinRT.Runtime.dll" />
      <None Include="@(WindowsToastFile)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <PackageReference Include="NLayer" Version="3.0.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>

</Project>
