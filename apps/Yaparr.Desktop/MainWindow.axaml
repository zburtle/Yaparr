<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Yaparr.Desktop"
        x:Class="Yaparr.Desktop.MainWindow"
        Title="Yaparr" Icon="avares://Yaparr.Desktop/Assets/yaparr.png" Width="1080" Height="680" MinWidth="800" MinHeight="440"
        Background="{DynamicResource AppBg}">
    <Window.Styles>
        <!-- Expandable headers: a flat toggle with a chevron that turns when open. -->
        <Style Selector="ToggleButton.expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ToggleButton.expander:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.expander:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="ToggleButton.expander:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.expander:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="ToggleButton.expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="ToggleButton.expander TextBlock.chevron">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="&#x25BC;" />
        </Style>
        <Style Selector="ToggleButton.expander:checked TextBlock.chevron">
            <Setter Property="Text" Value="&#x25B2;" />
        </Style>
        <Style Selector="ToggleButton.expander.up TextBlock.chevron">
            <Setter Property="Text" Value="&#x25B2;" />
        </Style>
        <Style Selector="ToggleButton.expander.up:checked TextBlock.chevron">
            <Setter Property="Text" Value="&#x25BC;" />
        </Style>
        <Style Selector="ToggleButton.expander:disabled TextBlock.chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Square icon buttons for the voice bar; "on" marks a switch that is currently active (muted, deafened, sharing). -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bad}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.details">
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Conversation list and people list: flat rows with a soft highlight. -->
        <Style Selector="ListBox.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.flat ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}" />
        </Style>
        <Style Selector="ListBox.people ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Messages: no selection highlight, bubbles carry the look. -->
        <Style Selector="ListBox.chat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style Selector="ListBox.chat ListBoxItem">
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ListBox.chat ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.chat ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.bubble">
            <Setter Property="Padding" Value="12,8,12,6" />
            <Setter Property="MaxWidth" Value="560" />
        </Style>
        <Style Selector="Border.bubble.other">
            <Setter Property="Background" Value="{DynamicResource BubbleOther}" />
            <Setter Property="CornerRadius" Value="16,16,16,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.bubble.mine">
            <Setter Property="Background" Value="{DynamicResource BubbleMine}" />
            <Setter Property="CornerRadius" Value="16,16,4,16" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Border.bubble.missed">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Border.bubble.mention">
            <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.quote">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="8,3,8,3" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.bubble.mine Border.quote TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.bubble.failed">
            <Setter Property="Background" Value="{DynamicResource Bad}" />
        </Style>
        <Style Selector="Border.bubble.mine SelectableTextBlock.body, Border.bubble.mine TextBlock.time">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.time">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.sys">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBlock.status.failed">
            <Setter Property="Foreground" Value="{DynamicResource Bad}" />
        </Style>

        <!-- Composer: a rounded box that holds a borderless text box. -->
        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- People: dot colours by state. -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="Ellipse.dot.online">
            <Setter Property="Fill" Value="{DynamicResource Good}" />
        </Style>
        <Style Selector="Ellipse.dot.warn">
            <Setter Property="Fill" Value="{DynamicResource Warn}" />
        </Style>
        <Style Selector="StackPanel.person.offline, Border.avatar.offline">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="TextBlock.state.online">
            <Setter Property="Foreground" Value="{DynamicResource Good}" />
        </Style>
        <Style Selector="TextBlock.state.warn">
            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
        <Menu Grid.Column="0" Margin="4,2,4,0">
            <MenuItem Header="_File">
                <MenuItem Header="_Create room…" Click="CreateRoom_Click" />
                <MenuItem Header="_Join with invite…" Click="JoinRoom_Click" />
                <Separator />
                <MenuItem Header="_Settings…" InputGesture="Ctrl+," Click="Settings_Click" />
                <MenuItem Header="Go to the first unread m_ention" Click="GoToFirstMention_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Connection guide…" Click="ConnectionGuide_Click" />
                <MenuItem Header="Check for _updates…" Click="CheckUpdates_Click" />
                <MenuItem Header="_Report a problem…" Click="ReportProblem_Click" />
                <Separator />
                <MenuItem Header="_About Yaparr" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Shown while rooms are getting going, or while a linked computer looks for the device it was linked from. It sits at the right
             end of the menu bar, so that it appearing and going does not push everything below it down and up. -->
        <Border x:Name="SyncBar" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,2,12,0" Padding="10,3" CornerRadius="6"
                Background="{DynamicResource Surface}" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="SyncBarText" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="SyncProgress" Width="72" Height="3" MinHeight="3" IsIndeterminate="True" Maximum="1" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        </Grid>

        <!-- Shown while the connection is lost and Yaparr is trying again. -->
        <Border x:Name="ReconnectBar" DockPanel.Dock="Top" Margin="12,6,12,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource Warn}" IsVisible="False">
            <TextBlock x:Name="ReconnectText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Latest alert only (copied, exported, update problems…); hidden when there is none. -->
        <Border x:Name="AlertBar" DockPanel.Dock="Bottom" Margin="16,2,16,6" IsVisible="False">
            <TextBlock x:Name="StatusText" Classes="muted small" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid ColumnDefinitions="354,*,Auto" Margin="8,4,8,0">
            <!-- Conversations -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,8,8">
                <DockPanel>
                    <DockPanel.Resources>
                            <DataTemplate x:Key="ConversationTemplate" x:DataType="local:ConversationVm">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Classes="avatar" Width="38" Height="38" Background="{Binding Avatar}">
                                            <TextBlock Text="{Binding Initial}" FontSize="15" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding ShowSubtitle}" Classes="muted small" />
                                            <TextBlock Text="{Binding SyncText}" IsVisible="{Binding HasSyncText}" Classes="small" Foreground="{DynamicResource Accent}" />
                                            <ProgressBar IsVisible="{Binding IsSyncing}" IsIndeterminate="True" Height="2" MinHeight="2" MinWidth="0" Width="64" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" IsVisible="{Binding HasUnread}" Background="{DynamicResource Accent}"
                                                CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="3" Classes="ghost" Content="{Binding OpenGlyph}" IsVisible="{Binding ShowChannels}" FontSize="10" Foreground="{DynamicResource Muted}" Width="26" Height="26" Padding="0"
                                                BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Margin="4,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Show or hide the channels" Click="ToggleChannels_Click" />
                                    </Grid>
                                    <StackPanel IsVisible="{Binding ShowChannelList}" Margin="48,6,0,2" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="label" Text="TEXT" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="ghost" Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding CanManageChannels}"
                                                    ToolTip.Tip="New text channel" Click="NewTextChannel_Click">
                                                <Path Data="M0,5 H10 M5,0 V10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding TextChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ChannelVm">
                                                    <Button Content="{Binding Label}" Classes="ghost" Classes.primary="{Binding Highlight}" HorizontalAlignment="Stretch" BorderThickness="0"
                                                            HorizontalContentAlignment="Left" Padding="8,3" Click="Channel_Click" ContextRequested="Channel_ContextRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Classes="label" Text="VOICE" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="ghost" Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding CanManageChannels}"
                                                    ToolTip.Tip="New voice channel" Click="NewVoiceChannel_Click">
                                                <Path Data="M0,5 H10 M5,0 V10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding VoiceChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ChannelVm">
                                                    <Button Content="{Binding Label}" Classes="ghost" Classes.primary="{Binding Highlight}" HorizontalAlignment="Stretch" BorderThickness="0"
                                                            HorizontalContentAlignment="Left" Padding="8,3" Click="Channel_Click" ContextRequested="Channel_ContextRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                    </DockPanel.Resources>
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
                        <ToggleButton x:Name="ProfileToggle" Classes="expander" PointerEntered="ProfileToggle_PointerEntered" PointerExited="ProfileToggle_PointerExited">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border x:Name="ProfileAvatar" Classes="avatar" Width="40" Height="40" Background="{DynamicResource Accent}">
                                    <TextBlock x:Name="ProfileInitial" FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <TextBlock x:Name="NameText" MaxWidth="120" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button x:Name="RenameButton" Grid.Column="1" Classes="ghost" Width="22" Height="22" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" IsVisible="False"
                                                ToolTip.Tip="Change my name" Click="Rename_Click">
                                            <Path Data="M1,11 V8 L8,1 L11,4 L4,11 Z M6,3 L9,6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="IdText" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="chevron" />
                            </Grid>
                        </ToggleButton>
                        <Border Classes="details" Margin="4,4,4,0" IsVisible="{Binding #ProfileToggle.IsChecked}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="YOUR PEER ID" />
                                <!-- The border has a background so the whole block answers the pointer, also between the lines of the ID. -->
                                <Border Background="Transparent" Cursor="Hand" ToolTip.Tip="Click to copy your ID so others can open a direct chat with you"
                                        PointerReleased="ProfileId_PointerReleased">
                                    <TextBlock x:Name="ProfileIdText" Classes="mono" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- The two lists follow one another and scroll together: the chats sit right under the rooms, not at the bottom. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="18,4,8,4">
                                <TextBlock Text="ROOMS" Classes="muted small" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Width="26" Height="26" Padding="0" BorderThickness="0" Background="Transparent" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Join a room with an invite" Click="JoinRoom_Click" Content="🔗" />
                                <Button Grid.Column="2" Classes="ghost" Width="26" Height="26" Padding="0" BorderThickness="0" Background="Transparent" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="New room" Click="CreateRoom_Click">
                                    <Button.Content><Path Data="M0,6 H12 M6,0 V12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button.Content>
                                </Button>
                            </Grid>
                            <ListBox x:Name="RoomList" Classes="flat" ItemTemplate="{StaticResource ConversationTemplate}"
                                     SelectionChanged="ConversationList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu Opening="ConversationMenu_Opening">
                                    <MenuItem Header="_Rename…" Click="RenameRoom_Click" />
                                    <MenuItem Header="_Leave room" Click="LeaveRoom_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            </ListBox>
                            <Grid ColumnDefinitions="*,Auto" Margin="18,10,8,4">
                                <TextBlock Text="DIRECT CHATS" Classes="muted small" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Width="26" Height="26" Padding="0" BorderThickness="0" Background="Transparent" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="New direct chat" Click="DirectChat_Click">
                                    <Button.Content><Path Data="M0,6 H12 M6,0 V12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button.Content>
                                </Button>
                            </Grid>
                            <ListBox x:Name="ChatList" Classes="flat" ItemTemplate="{StaticResource ConversationTemplate}"
                                     SelectionChanged="ConversationList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu Opening="ConversationMenu_Opening">
                                    <MenuItem Header="_Rename…" Click="RenameRoom_Click" />
                                    <MenuItem Header="_Leave room" Click="LeaveRoom_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Chat -->
            <Border Grid.Column="1" Classes="card" Margin="0,0,8,8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="10,8,10,0">
                            <ToggleButton x:Name="RoomToggle" Classes="expander" IsEnabled="False">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="Welcome to Yaparr" />
                                        <TextBlock x:Name="HeaderSubtitle" Classes="muted small" TextTrimming="CharacterEllipsis" Text="Serverless chat between friends" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="chevron" Margin="8,0,0,0" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel x:Name="VoiceBar" Grid.Column="1" x:DataType="local:ConversationVm" Orientation="Horizontal" Spacing="6"
                                        Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsRoom}">
                                <Button Content="🔊 Join voice" Classes="primary" IsVisible="{Binding CanJoinVoice}" Click="JoinVoice_Click" />
                                <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding PushToTalkHint}" IsVisible="{Binding HasPushToTalkHint}" />
                                <Button Classes="icon" Classes.on="{Binding Muted}" Content="{Binding MuteGlyph}" ToolTip.Tip="{Binding MuteTip}"
                                        IsVisible="{Binding CanUseVoiceControls}" Click="MuteVoice_Click" />
                                <Button Classes="icon" Classes.on="{Binding Deafened}" Content="🎧" ToolTip.Tip="{Binding DeafenTip}"
                                        IsVisible="{Binding CanUseVoiceControls}" Click="DeafenVoice_Click" />
                                <Button Classes="icon" Content="🎛" ToolTip.Tip="Soundboard" IsVisible="{Binding CanUseVoiceControls}" Click="Soundboard_Click" />
                                <Button Classes="icon" Content="🖥" ToolTip.Tip="Share your screen" IsVisible="{Binding CanShare}" Click="ShareScreen_Click" />
                                <Button Classes="icon on" Content="🖥" ToolTip.Tip="Stop sharing" IsVisible="{Binding CanStopSharing}" Click="StopSharing_Click" />
                                <Button Content="Leave" Foreground="{DynamicResource Bad}" ToolTip.Tip="Leave voice" IsVisible="{Binding CanUseVoiceControls}" Click="LeaveVoice_Click" />
                                <Button Classes="icon" Content="⋯" FontWeight="Bold" ToolTip.Tip="More">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Voice settings…" Click="VoiceSettings_Click" />
                                            <MenuItem Header="Copy invite" Click="CopyInvite_Click" IsVisible="{Binding HasInvite}" />
                                            <MenuItem Header="Replace the room key…" Click="RotateKey_Click" IsVisible="{Binding IsOwner}" />
                                            <Separator />
                                            <MenuItem Header="Rename…" Click="RenameRoom_Click" />
                                            <MenuItem Header="Leave room" Click="LeaveRoom_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="DetailsPanel" x:DataType="local:ConversationVm" Classes="details" Margin="14,6,14,0"
                                IsVisible="{Binding #RoomToggle.IsChecked}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="ROOM KEY (INVITE)" IsVisible="{Binding HasInvite}" />
                                <!-- Clicking the key copies it, like the peer ID at the top left; the button next to it copies a link that opens Yaparr. -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasInvite}">
                                    <Border Background="Transparent" Cursor="Hand" ToolTip.Tip="Click to copy the room key" PointerReleased="RoomKey_PointerReleased">
                                        <TextBlock Classes="mono" Text="{Binding Invite}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="1" Content="Copy link" Margin="8,0,0,0" VerticalAlignment="Top"
                                            ToolTip.Tip="Copy a link that opens Yaparr and joins this room" Click="CopyInviteLink_Click" />
                                </Grid>
                                <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasInvite}"
                                           Text="Anyone who has the key or the link can join the room. Share it carefully." />

                                <TextBlock Classes="label" Text="PEER ID" IsVisible="{Binding HasPeerId}" />
                                <SelectableTextBlock Classes="mono" Text="{Binding PeerId}" IsVisible="{Binding HasPeerId}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPeerId}">
                                    <Button Content="Copy peer ID" Click="CopyPeerId_Click" />
                                    <Button Content="Copy chat link" ToolTip.Tip="Copy a link that opens Yaparr and starts a chat with them" Click="CopyChatLink_Click" />
                                </StackPanel>

                                <TextBlock Classes="label" Text="PEOPLE" Margin="0,4,0,0" IsVisible="{Binding IsRoom}" />
                                <TextBlock Classes="small" Text="{Binding MembersText}" IsVisible="{Binding IsRoom}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="VoicePanel" x:DataType="local:ConversationVm" IsVisible="{Binding ShowVoiceRow}" Margin="14,8,14,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <ItemsControl ItemsSource="{Binding VoiceMembers}" IsVisible="{Binding HasVoiceMembers}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:VoiceMemberVm">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,4">
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{Binding Avatar}"
                                                        BorderBrush="{Binding Ring}" BorderThickness="3">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Status}" Classes="muted small" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Where}" Classes="muted small" VerticalAlignment="Center" />
                                                <Button Content="🔊" Classes="ghost" IsVisible="{Binding CanSetVolume}" Padding="4,0" FontSize="11"
                                                        VerticalAlignment="Center" ToolTip.Tip="{Binding VolumeText, StringFormat='Volume {0}'}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                            <StackPanel Width="220" Spacing="6">
                                                                <TextBlock Classes="label" Text="VOLUME" />
                                                                <Slider Minimum="0" Maximum="200" SmallChange="5" LargeChange="20" TickFrequency="50" TickPlacement="BottomRight"
                                                                        Value="{Binding Volume, Mode=TwoWay}" />
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="1" Content="Reset" Click="ResetVolume_Click" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Content="{Binding SoundboardGlyph}" IsVisible="{Binding CanMuteSoundboard}" Click="SoundboardMute_Click"
                                                        ToolTip.Tip="{Binding SoundboardTip}" Classes="ghost" Padding="4,0" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Someone is sharing a screen. Join voice to watch it." Classes="muted small" TextWrapping="Wrap" MaxWidth="260"
                                               IsVisible="{Binding NeedsVoiceToWatch}" />
                                    <ItemsControl ItemsSource="{Binding Shares}" IsVisible="{Binding CanWatchShares}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ShareVm">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                                    <TextBlock Text="🖥" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Button Content="{Binding ButtonText}" IsVisible="{Binding CanWatch}" Click="WatchScreen_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource Line}" />
                    </StackPanel>

                    <ListBox x:Name="MessageList" Grid.Row="1" Classes="chat" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:MessageVm">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="sys" IsVisible="{Binding ShowDay}" Text="{Binding DayLabel}"
                                               HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,6" />
                                    <TextBlock Classes="sys" IsVisible="{Binding IsSystem}" Text="{Binding Text}" />
                                    <TextBlock IsVisible="{Binding ShowSender}" Text="{Binding Sender}" Foreground="{Binding SenderBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="10,6,0,0" />
                                    <Border Classes="bubble" IsVisible="{Binding !IsSystem}"
                                            Classes.mine="{Binding IsMine}" Classes.other="{Binding IsOther}"
                                            Classes.missed="{Binding IsCatchUp}" Classes.failed="{Binding IsFailed}" Classes.mention="{Binding Highlight}">
                                        <StackPanel Spacing="2">
                                            <Border Classes="quote" IsVisible="{Binding HasQuote}" PointerReleased="Quote_PointerReleased">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding QuoteSender}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding QuoteText}" FontSize="12" Opacity="0.85" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Grid IsVisible="{Binding HasAttachment}" HorizontalAlignment="Left">
                                                <local:PictureView Data="{Binding Image}" Thumbnail="{Binding Thumbnail}"
                                                                   PixelWidth="{Binding PixelWidth}" PixelHeight="{Binding PixelHeight}" />
                                                <ProgressBar IsVisible="{Binding IsFetching}" Value="{Binding ProgressPercent}" Maximum="100"
                                                             Height="4" VerticalAlignment="Bottom" />
                                                <Button IsVisible="{Binding NeedsAction}" Content="{Binding ActionText}" Classes="primary"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="Download_Click" />
                                            </Grid>
                                            <local:MessageText Classes="body" IsVisible="{Binding HasText}" Body="{Binding Text}" Marks="{Binding MentionMarks}" TextWrapping="Wrap" />
                                            <TextBlock Classes="time" Text="{Binding TimeText}" ToolTip.Tip="{Binding FullTime}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Classes="status" Classes.failed="{Binding CanRetry}" IsVisible="{Binding HasStatus}" Text="{Binding Status}" ToolTip.Tip="{Binding DeliveryDetail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Opening="MessageMenu_Opening">
                                <MenuItem x:Name="ReplyItem" Header="_Reply" Click="Reply_Click" />
                                <MenuItem x:Name="SavePictureItem" Header="_Save picture as…" Click="SavePicture_Click" />
                                <MenuItem x:Name="AddToShelfItem" Header="Add to my _GIF shelf" Click="AddToShelf_Click" />
                                <MenuItem x:Name="RetryItem" Header="_Retry sending" Click="RetryMessage_Click" />
                                <MenuItem x:Name="DeleteMessageItem" Header="_Delete for everyone" Click="DeleteMessage_Click" />
                                <MenuItem x:Name="BanSenderItem" Header="Ban sender from this _room…" Click="BanSender_Click" />
                                <MenuItem x:Name="BlockSenderItem" Header="_Block sender" Click="BlockSender_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="360">
                        <Image Source="avares://Yaparr.Desktop/Assets/yaparr.png" Width="96" Height="96" HorizontalAlignment="Center" />
                        <TextBlock Text="No conversation open" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Create a room, join one with an invite, or open a direct chat to begin." />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                    <Border x:Name="ReplyBar" IsVisible="False" Margin="14,4,14,0" Padding="12,6,6,6" CornerRadius="12" Background="{DynamicResource BubbleOther}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Background="Transparent" VerticalAlignment="Center"
                                    ToolTip.Tip="Cancel the reply (Esc)" Click="CancelReply_Click" />
                            <StackPanel>
                                <TextBlock x:Name="ReplyBarTitle" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ReplyBarText" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Popup x:Name="ShelfPopup" PlacementTarget="{Binding #ShelfButton}" Placement="TopEdgeAlignedLeft" IsLightDismissEnabled="True" Closed="ShelfPopup_Closed">
                        <Border Padding="8" CornerRadius="12" Width="372" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,6">
                                    <StackPanel x:Name="ShelfTabs" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button x:Name="ShelfMineTab" Content="My shelf" Classes="primary" Padding="10,3" CornerRadius="14" Click="ShelfMine_Click" />
                                        <Button x:Name="ShelfRoomTab" Content="This room" Padding="10,3" CornerRadius="14" Click="ShelfRoom_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ShelfCount" Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button x:Name="ShelfAddButton" Grid.Column="2" Content="Add…" Padding="10,3" CornerRadius="14" Click="ShelfAdd_Click" />
                                </Grid>
                                <TextBlock x:Name="ShelfEmpty" DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="4,6,4,10" IsVisible="False"
                                           Text="Nothing here yet. Add GIFs and pictures you like to send again, or right-click one in a chat and choose Add to my GIF shelf. They stay on this computer." />
                                <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="ShelfGrid" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="MentionPopup" PlacementTarget="{Binding #InputBox}" Placement="TopEdgeAlignedLeft" IsLightDismissEnabled="False">
                        <Border Padding="4" CornerRadius="10" MinWidth="220" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ListBox x:Name="MentionList" Classes="flat" MaxHeight="190" DoubleTapped="MentionList_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:MentionChoice">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                    <Border Margin="14,4,14,14" Padding="14,2,6,2" CornerRadius="22"
                            Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <DockPanel>
                            <Button x:Name="SendButton" DockPanel.Dock="Right" VerticalAlignment="Bottom" Content="Send" Classes="primary" CornerRadius="18" Padding="18,7"
                                    Margin="6,4,0,4" IsEnabled="False" Click="Send_Click" />
                            <Button x:Name="AttachButton" DockPanel.Dock="Left" VerticalAlignment="Bottom" Content="📎" Padding="8,6" Margin="0,4,2,4" CornerRadius="18"
                                    Background="Transparent" IsEnabled="False" ToolTip.Tip="Send a picture or GIF" Click="Attach_Click" />
                            <Button x:Name="ShelfButton" DockPanel.Dock="Left" VerticalAlignment="Bottom" Content="GIF" FontSize="11" FontWeight="SemiBold" Padding="8,6" Margin="0,4,2,4" CornerRadius="18"
                                    Background="Transparent" IsEnabled="False" ToolTip.Tip="Your GIF shelf" Click="Shelf_Click" />
                            <TextBox x:Name="InputBox" Classes="composer" PlaceholderText="Write a message" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150"
                                     ToolTip.Tip="Enter sends the message; Shift+Enter starts a new line" />
                        </DockPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- A shared screen watched inside the app, over the chat -->
            <Border x:Name="ScreenOverlay" Grid.Column="1" Classes="card" Margin="0,0,8,8" IsVisible="False" ClipToBounds="True">
                <Border x:Name="ScreenHost" />
            </Border>

            <!-- People -->
            <Border x:Name="PeoplePanel" Grid.Column="2" Width="236" Classes="card" Margin="0,0,0,8" IsVisible="False">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,14,8">
                        <TextBlock x:Name="PeopleHeader" Text="People" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="PeopleCount" Grid.Column="1" Classes="muted small" VerticalAlignment="Center" />
                    </Grid>
                    <Border x:Name="SharerPanel" DockPanel.Dock="Bottom" IsVisible="False" />
                    <!-- What the people watching your share see, above the readout of it. -->
                    <local:SharePreviewView x:Name="SharePreview" DockPanel.Dock="Bottom" Margin="12,6,12,0" />
                    <!-- Connection state as icons; colour says how it is going and the details are in each one's tooltip. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16" Margin="16,6,12,12">
                        <TextBlock x:Name="PeersIcon" FontSize="15" Text="👥 0" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="NetworkIcon" FontSize="15" Text="🌐" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="VpnIcon" FontSize="15" Text="🔒" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="InfoIcon" FontSize="15" Text="ⓘ" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <ListBox x:Name="PeopleList" Classes="flat people" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu Opening="PeopleMenu_Opening">
                                <MenuItem x:Name="DirectChatPersonItem" Header="_Direct chat" Click="DirectChatPerson_Click" />
                                <MenuItem x:Name="MakeAdminItem" Header="Make _admin of this room" Click="MakeAdmin_Click" />
                                <MenuItem x:Name="RemoveAdminItem" Header="Remove _admin from this room" Click="RemoveAdmin_Click" />
                                <MenuItem x:Name="BanPersonItem" Header="Ban from this _room…" Click="BanPerson_Click" />
                                <MenuItem x:Name="UnbanPersonItem" Header="Unban from this _room" Click="UnbanPerson_Click" />
                                <MenuItem x:Name="BlockPersonItem" Header="_Block" Click="BlockPerson_Click" />
                                <MenuItem x:Name="UnblockPersonItem" Header="_Unblock" Click="UnblockPerson_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:PeerVm">
                                <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Tip}">
                                    <Grid Width="36" Height="36">
                                        <Border Classes="avatar" Classes.offline="{Binding !Online}" Background="{Binding Avatar}">
                                            <TextBlock Text="{Binding Initial}" FontSize="14" />
                                        </Border>
                                        <Ellipse Classes="dot" Classes.online="{Binding Online}" Classes.warn="{Binding Warn}"
                                                 Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Stroke="{DynamicResource Surface}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Classes="person" Classes.offline="{Binding !Online}">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="state" Classes.online="{Binding Online}" Classes.warn="{Binding Warn}" Text="{Binding StateText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

    <!-- The settings: sections on the left, the section's controls on the right, over the window. Escape, the cross or a click outside closes it. -->
    <Border x:Name="SettingsOverlay" IsVisible="False" Background="#D8000000" Padding="24" Focusable="True"
            AutomationProperties.Name="Settings" SizeChanged="SettingsOverlay_SizeChanged"
            PointerPressed="SettingsOverlay_PointerPressed" KeyDown="SettingsOverlay_KeyDown">
        <Border Classes="card" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="780" MaxHeight="960" Padding="0"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid x:Name="SettingsGrid" RowDefinitions="Auto,Auto,*" ColumnDefinitions="200,*">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="18,14,0,10" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"
                        AutomationProperties.Name="Close settings" ToolTip.Tip="Close (Esc)" Click="CloseSettings_Click" />
                <!-- In a narrow window the list of sections is this drop-down instead. -->
                <ComboBox x:Name="SettingsPicker" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" HorizontalAlignment="Stretch" Margin="18,0,18,10"
                          AutomationProperties.Name="Settings section" SelectionChanged="SettingsPicker_SelectionChanged">
                    <ComboBoxItem Content="Devices" Tag="devices" />
                    <ComboBoxItem Content="Notifications" Tag="notifications" />
                    <ComboBoxItem Content="Voice &amp; audio" Tag="voice" />
                    <ComboBoxItem Content="Network" Tag="network" />
                    <ComboBoxItem Content="VPN" Tag="vpn" />
                    <ComboBoxItem Content="TURN relay" Tag="turn" />
                    <ComboBoxItem Content="Blocked people" Tag="blocked" />
                    <ComboBoxItem Content="Backup" Tag="backup" />
                    <ComboBoxItem Content="About" Tag="about" />
                </ComboBox>
                <TreeView x:Name="SettingsTree" Grid.Row="2" Margin="8,0,0,8" AutomationProperties.Name="Settings sections" SelectionChanged="SettingsTree_SelectionChanged">
                    <TreeViewItem Header="Devices" Tag="devices" />
                    <TreeViewItem Header="Notifications" Tag="notifications" />
                    <TreeViewItem Header="Voice &amp; audio" Tag="voice" />
                    <TreeViewItem x:Name="NetworkNode" Header="Network" Tag="network">
                        <TreeViewItem Header="VPN" Tag="vpn" />
                        <TreeViewItem Header="TURN relay" Tag="turn" />
                    </TreeViewItem>
                    <TreeViewItem Header="Blocked people" Tag="blocked" />
                    <TreeViewItem Header="Backup" Tag="backup" />
                    <TreeViewItem Header="About" Tag="about" />
                </TreeView>
                <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Panel Margin="18,4,18,18">
                        <StackPanel x:Name="SectionDevices" Spacing="10">
                            <TextBlock Text="Devices" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="One person can use Yaparr on several computers. Your name, rooms and blocks carry over to a linked device." />
                            <Border Classes="details" Padding="10,8">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock Classes="label" Text="DEVICE" />
                                        <TextBlock Grid.Column="1" Classes="label" Text="CONNECTION" />
                                    </Grid>
                                    <ItemsControl x:Name="DeviceTable">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:DeviceRow">
                                                <Grid ColumnDefinitions="*,*" Margin="0,2">
                                                    <TextBlock Text="{Binding Device}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Connection}" Classes="muted" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="muted small" TextWrapping="Wrap"
                                       Text="Your other devices show here while they are on and connected to this one. A message you sent from another device says so next to its time." />
                            <Button Content="Link another device…" HorizontalAlignment="Left" Click="LinkDevice_Click" />
                        </StackPanel>
                        <StackPanel x:Name="SectionNotifications" Spacing="10" IsVisible="False">
                            <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox x:Name="SoundsItem" Content="Play sounds" />
                            <CheckBox x:Name="FlashItem" Content="Flash the taskbar button" />
                            <CheckBox x:Name="TaskbarCountItem" Content="Show the unread count on the taskbar" />
                            <CheckBox x:Name="PopupsItem" Content="Show pop-ups when the window is in the background" IsVisible="False" />
                            <CheckBox x:Name="MentionsOnlyItem" Content="Only for mentions, replies and direct messages" />
                            <TextBlock Text="Message sound" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <ComboBox x:Name="MessageSoundBox" HorizontalAlignment="Left" MinWidth="200" />
                            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Each sound plays when it is picked." />
                        </StackPanel>
                        <StackPanel x:Name="SectionVoice" Spacing="10" IsVisible="False">
                            <TextBlock Text="Voice &amp; audio" FontSize="15" FontWeight="SemiBold" />
                            <local:VoiceSettingsView x:Name="VoiceView" />
                        </StackPanel>
                        <StackPanel x:Name="SectionNetwork" Spacing="10" IsVisible="False">
                            <TextBlock Text="Network" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="If people cannot reach you, this shows why. A VPN or a TURN relay, under Network in the list, can help." />
                            <local:NetworkCheckView x:Name="NetworkView" />
                        </StackPanel>
                        <StackPanel x:Name="SectionVpn" Spacing="10" IsVisible="False">
                            <TextBlock Text="VPN" FontSize="15" FontWeight="SemiBold" />
                            <local:VpnView x:Name="VpnPanel" />
                        </StackPanel>
                        <StackPanel x:Name="SectionTurn" Spacing="10" IsVisible="False">
                            <TextBlock Text="TURN relay" FontSize="15" FontWeight="SemiBold" />
                            <local:TurnView x:Name="TurnPanel" />
                        </StackPanel>
                        <StackPanel x:Name="SectionBlocked" Spacing="10" IsVisible="False">
                            <TextBlock Text="Blocked people" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="You do not see their messages or hear them. Unblocking lets them back into your lists." />
                            <TextBlock x:Name="BlockedEmpty" Classes="muted" Text="You have not blocked anyone." />
                            <ItemsControl x:Name="BlockedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BlockedRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ShortId}" Classes="muted small" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Unblock" MinWidth="80" HorizontalContentAlignment="Center" Click="Unblock_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="SectionBackup" Spacing="10" IsVisible="False">
                            <TextBlock Text="Backup" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Saves a zip of everything Yaparr keeps for you: your identity key, rooms, message history, pictures and settings. Keep it somewhere safe; it holds your account key." />
                            <Button Content="Back up profile…" HorizontalAlignment="Left" Click="BackupProfile_Click" />
                        </StackPanel>
                        <StackPanel x:Name="SectionAbout" Spacing="10" IsVisible="False">
                            <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                            <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" />
                            <Button Content="Copy sharing diagnostics" Click="CopySharingDiagnostics_Click" ToolTip.Tip="For a problem with sharing a screen or watching one: how this computer shares, what the last share did and the log lines about it" />
                            <Button Content="Open log file" Click="OpenLog_Click" />
                            <Button Content="Open log folder" Click="OpenLogFolder_Click" />
                            <Button Content="Open source licences" Click="OpenLicences_Click" />
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>

    <!-- The soundboard over the window, like the settings. Escape, the cross or a click outside puts it away; Pop out moves it to a window of its own. -->
    <Border x:Name="SoundboardOverlay" IsVisible="False" Background="#D8000000" Padding="24" Focusable="True"
            AutomationProperties.Name="Soundboard"
            PointerPressed="SoundboardOverlay_PointerPressed" KeyDown="SoundboardOverlay_KeyDown">
        <Border Classes="card" x:Name="SoundboardHost" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="760" MaxHeight="760"
                ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle" />
    </Border>

    <!-- A picture from the chat shown large over everything else. A click or Escape closes it. -->
    <Border x:Name="PictureOverlay" IsVisible="False" Background="#D8000000" Padding="32" Focusable="True"
            PointerReleased="PictureOverlay_PointerReleased" KeyDown="PictureOverlay_KeyDown">
        <Border x:Name="PictureHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    </Grid>
</Window>
