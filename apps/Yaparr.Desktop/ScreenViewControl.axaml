<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yaparr.Desktop.ScreenViewControl">
    <Grid RowDefinitions="*,Auto" Background="Black">
        <Image x:Name="Picture" Stretch="Uniform" />
        <TextBlock x:Name="Waiting" Text="Waiting for the first picture..." Foreground="#bbbbbb"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="Interrupted" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Padding="14,6" CornerRadius="6"
                Background="#CC000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock x:Name="InterruptedText" Foreground="White" FontSize="14" Text="The stream was interrupted. Reconnecting…" />
        </Border>
        <Border x:Name="Struggling" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,64,16,0" Padding="14,6" CornerRadius="6"
                Background="#CC000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Text="The picture is struggling on your connection. The others are fine." />
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="4"
                Background="#55000000" IsHitTestVisible="False" IsVisible="False" x:Name="FpsBadge">
            <TextBlock x:Name="FpsText" Foreground="#AAFFFFFF" FontSize="11" />
        </Border>
        <Grid x:Name="Controls" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Background="Black">
            <TextBlock x:Name="Info" Foreground="#999999" FontSize="11" Margin="8,4" VerticalAlignment="Center" />
            <StackPanel x:Name="SoundPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,4" IsVisible="False">
                <TextBlock Text="Sound" Foreground="#999999" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="SoundBox" Minimum="0" Maximum="200" Value="100" Width="120" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,4" VerticalAlignment="Center">
                <Button x:Name="FullScreenButton" Content="Full screen" Padding="10,4" ToolTip.Tip="Full screen (F11, or double-click the picture). Esc leaves it." />
                <Button x:Name="DockButton" Content="Pop out" Padding="10,4" />
                <Button x:Name="StopButton" Content="Stop watching" Padding="10,4" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
