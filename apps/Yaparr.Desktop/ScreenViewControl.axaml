<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yaparr.Desktop.ScreenViewControl">
    <Grid RowDefinitions="*,Auto" Background="Black">
        <Image x:Name="Picture" Stretch="Uniform" />
        <TextBlock x:Name="Waiting" Text="Waiting for the first picture..." Foreground="#bbbbbb"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="Interrupted" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Padding="14,6" CornerRadius="6"
                Background="#CC000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock x:Name="InterruptedText" Foreground="White" FontSize="14" Text="The stream was interrupted. Reconnecting…" />
        </Border>
        <Border x:Name="Struggling" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,64,16,0" Padding="14,6" CornerRadius="6"
                Background="#CC000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Text="The picture is struggling on your connection. The others are fine." />
        </Border>
        <!-- A film played from Jellyfin says what it is, how far it is, and when it is paused (see FilmStatus). -->
        <Border x:Name="FilmPaused" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,12" CornerRadius="12"
                Background="#99000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock Text="⏸  Paused" Foreground="White" FontSize="22" />
        </Border>
        <Border x:Name="FilmBar" VerticalAlignment="Bottom" Background="#B0000000" Padding="14,8,14,8" IsHitTestVisible="False" IsVisible="False">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="FilmTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FilmTimes" Grid.Column="1" Foreground="#CCFFFFFF" FontSize="13" Margin="12,0,0,0" />
                </Grid>
                <ProgressBar x:Name="FilmProgress" Minimum="0" Maximum="1000" Height="4" MinHeight="4" />
            </StackPanel>
        </Border>
        <Border x:Name="LowNotice" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="4"
                Background="#99000000" IsHitTestVisible="False" IsVisible="False">
            <TextBlock x:Name="LowNoticeText" Foreground="#DDFFFFFF" FontSize="12" TextWrapping="Wrap" MaxWidth="520" Text="Watching a lower-quality stream" />
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="4"
                Background="#55000000" IsHitTestVisible="False" IsVisible="False" x:Name="FpsBadge">
            <TextBlock x:Name="FpsText" Foreground="#AAFFFFFF" FontSize="11" />
        </Border>
        <Grid x:Name="Controls" Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" Background="Black">
            <!-- The film the sharer plays has its player here: pause, jump, next episode (see AttachPlayer). -->
            <Border x:Name="PlayerHost" Grid.ColumnSpan="3" IsVisible="False" Padding="10,6,10,2" />
            <TextBlock x:Name="Info" Grid.Row="1" Foreground="#999999" FontSize="11" Margin="8,4" VerticalAlignment="Center" />
            <StackPanel x:Name="SoundPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,4" IsVisible="False">
                <TextBlock Text="Sound" Foreground="#999999" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="SoundBox" Minimum="0" Maximum="200" Value="100" Width="120" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,4" VerticalAlignment="Center">
                <!-- For the film you play: pick something else to play now (see ShowChangeButton). -->
                <Button x:Name="ChangeButton" Content="Change…" Padding="10,4" IsVisible="False" ToolTip.Tip="Pick something else to play now" />
                <Button x:Name="FullScreenButton" Content="Full screen" Padding="10,4" ToolTip.Tip="Full screen (F11, or double-click the picture). Esc leaves it." />
                <Button x:Name="DockButton" Content="Pop out" Padding="10,4" />
                <Button x:Name="StopButton" Content="Stop watching" Padding="10,4" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
