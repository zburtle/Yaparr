<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.ServerLoginDialog"
        Title="Restore from a server" Icon="avares://Yaparr.Desktop/Assets/yaparr.png" SizeToContent="Height" Width="460" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="4">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Bring your account back from a backup you saved on a backup server. You sign in in your browser, and the backup is unlocked here with your recovery code, which is never sent to the server." />
        <TextBlock Text="Server address" Classes="muted" />
        <TextBox x:Name="UrlBox" PlaceholderText="https://backup.example.org" />
        <TextBlock Text="Recovery code" Classes="muted" Margin="0,8,0,0" />
        <TextBox x:Name="CodeBox" PlaceholderText="K7QD-M3XF-9PLR-2WTE-HV8N-C4YB" FontFamily="Consolas,Menlo,monospace" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Sign in and restore" Classes="primary" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
