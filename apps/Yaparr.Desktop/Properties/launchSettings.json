{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Yaparr (your profile)": {
      "commandName": "Project"
    },
    "Yaparr (your profile, in-process encoder)": {
      "commandName": "Project",
      "environmentVariables": {
        "YAPARR_INPROCESS": "1"
      }
    },
    "Yaparr (your profile, in-process capture, pictures on the card)": {
      "commandName": "Project",
      "environmentVariables": {
        "YAPARR_INPROCESS": "capture"
      }
    },
    "Yaparr (your profile, in-process capture, pictures copied to memory)": {
      "commandName": "Project",
      "environmentVariables": {
        "YAPARR_INPROCESS": "capture-cpu"
      }
    },
    "alice (separate profile)": {
      "commandName": "Project",
      "commandLineArgs": "--name alice --data \"%TEMP%\\yaparr-desktop\\alice\""
    },
    "bob (separate profile)": {
      "commandName": "Project",
      "commandLineArgs": "--name bob --data \"%TEMP%\\yaparr-desktop\\bob\""
    }
  }
}
