# Public IPv4 address of the server. Must be the address clients can reach; for a server behind NAT use
# "public/private" (for example 203.0.113.5/10.0.0.4).
TURN_PUBLIC_IP=
TURN_USER=yaparr
# Required: the server will not start without it. Make it long and random, for example:  openssl rand -base64 32
TURN_PASSWORD=
# UDP port clients connect to (entered in Yaparr's TURN dialog as host:port).
TURN_PORT=443
# UDP range for relayed traffic. Open it in the firewall; ~250 ports allows ~250 concurrent relays.
TURN_MIN_PORT=49152
TURN_MAX_PORT=49400
TURN_REALM=yaparr
# Bandwidth cap per relayed session, in bytes per second. Chat is tiny; this limits what a leaked credential is worth.
TURN_MAX_BPS=250000
