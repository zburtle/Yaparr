<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Yaparr"
           Manufacturer="Yaparr"
           Version="$(Version)"
           UpgradeCode="80FFEB1D-8F5E-4901-A554-8D837F3882F1"
           Scope="perUser"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Yaparr is already installed." />

    <!-- A running Yaparr (even one hidden in the notification area) is asked to quit before its files are replaced, as an upgrade or an uninstall
         begins. It is asked as Windows asks a program to end its session (WM_QUERYENDSESSION), which the app takes as a real quit; a plain close
         message would only hide it. If it is still there afterwards, the usual "files in use" prompt of the installer follows. -->
    <util:CloseApplication Id="CloseYaparr" Target="Yaparr.Desktop.exe" EndSessionMessage="yes" CloseMessage="no" RebootPrompt="no" Timeout="15" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\assets\logo\yaparr.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Yaparr" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <!-- No Icon attribute on purpose: the shortcut then takes the icon of the program it starts (Yaparr.Desktop.exe has it built in). With the icon
             from the installer's own table, Windows keeps that file in a folder named for the version's product code and deletes it when an upgrade removes
             the old version, so a shortcut that still pointed there (one pinned to the taskbar or copied to the desktop, or the Start menu one while the
             new one is not written yet) was left with the blank "page" icon. -->
        <Shortcut Id="AppShortcut" Name="Yaparr" Description="Peer-to-peer chat"
                  Target="[INSTALLFOLDER]Yaparr.Desktop.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Yaparr" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <!-- yaparr:// links (shared as https://yaparr.com/join#... pages) open in this app. -->
        <RegistryKey Root="HKCU" Key="Software\Classes\yaparr">
          <RegistryValue Type="string" Value="URL:Yaparr" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]Yaparr.Desktop.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Yaparr.Desktop.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Yaparr" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetLaunchTarget" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Yaparr" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="SetLaunchTarget" Property="WixShellExecTarget" Value="[INSTALLFOLDER]Yaparr.Desktop.exe" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
  </Package>
</Wix>
