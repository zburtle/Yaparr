{
  "branches": ["master"],
  "tagFormat": "android-v${version}",
  "plugins": [
    ["./.github/release/track-filter.js", { "track": "android" }],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "installers/*.apk" }, { "path": "installers/*-symbols.zip" }],
        "releaseNameTemplate": "Android ${nextRelease.version}",
        "draftRelease": true
      }
    ]
  ]
}
