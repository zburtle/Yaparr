{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    ["./.github/release/track-filter.js", { "track": "desktop" }],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "installers/*" }]
      }
    ]
  ]
}
