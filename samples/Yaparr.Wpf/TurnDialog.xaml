<Window x:Class="Yaparr.Wpf.TurnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TURN relay" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="A TURN server relays Yaparr's traffic when two peers cannot connect directly (for example behind symmetric NAT). Messages stay end-to-end signed; the relay only forwards packets." />
        <CheckBox x:Name="EnabledBox" Content="Use a TURN relay" Margin="0,0,0,8" />
        <TextBlock Text="Server (host:port)" />
        <TextBox x:Name="ServerBox" Margin="0,2,0,8" />
        <TextBlock Text="Username" />
        <TextBox x:Name="UserBox" Margin="0,2,0,8" />
        <TextBlock Text="Password / credential" />
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8" />
        <CheckBox x:Name="AlwaysBox" Content="Always relay (otherwise only when behind a NAT that blocks direct connections)" Margin="0,0,0,8" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="Gray" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save" Padding="10,4" MinWidth="80" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Close" IsCancel="True" Padding="10,4" MinWidth="70" />
        </StackPanel>
    </StackPanel>
</Window>
