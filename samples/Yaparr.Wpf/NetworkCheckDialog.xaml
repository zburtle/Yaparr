<Window x:Class="Yaparr.Wpf.NetworkCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check connection" Width="520" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking…" />
        <ItemsControl x:Name="Items" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold" Width="22" FontSize="15" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Foreground="DimGray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy report" Padding="10,4" Margin="0,0,8,0" IsEnabled="False" Click="Copy_Click" />
            <Button x:Name="AgainButton" Content="Check again" Padding="10,4" Margin="0,0,8,0" IsEnabled="False" Click="Again_Click" />
            <Button Content="Close" IsCancel="True" Padding="10,4" MinWidth="70" />
        </StackPanel>
    </StackPanel>
</Window>
