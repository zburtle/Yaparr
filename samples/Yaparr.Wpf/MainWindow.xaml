<Window x:Class="Yaparr.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yaparr" Width="960" Height="620" MinWidth="640" MinHeight="400">
    <Window.Resources>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Create private room…" Click="CreateRoom_Click" />
                <MenuItem Header="_Join with invite…" Click="JoinRoom_Click" />
                <Separator />
                <MenuItem Header="Copy my _ID" Click="CopyId_Click" />
                <MenuItem Header="_Import profile…" Click="ImportProfile_Click" />
                <MenuItem Header="_Export profile…" Click="ExportProfile_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Network">
                <MenuItem Header="_VPN…" Click="Vpn_Click" />
                <MenuItem Header="_TURN relay…" Click="Turn_Click" />
                <Separator />
                <MenuItem Header="_Check connection…" Click="CheckNetwork_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates…" Click="CheckUpdates_Click" />
                <MenuItem Header="Open _log file" Click="OpenLog_Click" />
                <Separator />
                <MenuItem Header="_About Yaparr" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="DimGray" />
                <TextBlock x:Name="StatusText" Text="Starting…" Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" />
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Content="Copy ID" Padding="6,1" Margin="6,0,0,0" Click="CopyId_Click"
                                ToolTip="Copy your peer ID so others can open a direct chat with you" />
                        <TextBlock x:Name="IdText" Foreground="DimGray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Create private room…" Style="{StaticResource SideButton}" Click="CreateRoom_Click" />
                    <Button Content="Join with invite…" Style="{StaticResource SideButton}" Click="JoinRoom_Click" />
                    <Button Content="Direct chat…" Style="{StaticResource SideButton}" Click="DirectChat_Click" />
                </StackPanel>
                <ListBox x:Name="ConversationList" DisplayMemberPath="Label" SelectionChanged="ConversationList_SelectionChanged"
                         PreviewMouseRightButtonDown="ConversationList_RightClick" ContextMenuOpening="ConversationList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Rename…" Click="RenameRoom_Click" />
                            <MenuItem Header="_Leave room" Click="LeaveRoom_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="InviteButton" DockPanel.Dock="Right" Content="Copy invite" Padding="8,2" Visibility="Collapsed" Click="CopyInvite_Click" />
                    <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Text="Create a private room, join one with an invite, or open a direct chat to begin" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="70" Margin="6,0,0,0" IsEnabled="False" Click="Send_Click" />
                    <TextBox x:Name="InputBox" Padding="4" IsEnabled="False" KeyDown="InputBox_KeyDown" />
                </DockPanel>
                <ListBox x:Name="MessageList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="MessageList_RightClick" ContextMenuOpening="MessageList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Retry sending" Click="RetryMessage_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Line" Text="{Binding Display}" TextWrapping="Wrap" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="system">
                                    <Setter TargetName="Line" Property="Foreground" Value="DimGray" />
                                    <Setter TargetName="Line" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="missed">
                                    <Setter TargetName="Line" Property="Foreground" Value="SlateGray" />
                                    <Setter TargetName="Line" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="failed">
                                    <Setter TargetName="Line" Property="Foreground" Value="Firebrick" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="mine">
                                    <Setter TargetName="Line" Property="Foreground" Value="SteelBlue" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2" Margin="8">
                <TextBlock x:Name="PeopleHeader" DockPanel.Dock="Top" Text="People" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="PeopleList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0" Fill="Gray" VerticalAlignment="Center" />
                                <TextBlock x:Name="State" DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding StateText}" Foreground="Gray" />
                                <TextBlock x:Name="Label" Text="{Binding Display}" TextTrimming="CharacterEllipsis" Foreground="Gray" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Online}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="SeaGreen" />
                                    <Setter TargetName="State" Property="Foreground" Value="SeaGreen" />
                                    <Setter TargetName="Label" Property="Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Link}" Value="NotResponding">
                                    <Setter TargetName="State" Property="Foreground" Value="DarkOrange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Link}" Value="Reconnecting">
                                    <Setter TargetName="State" Property="Foreground" Value="DarkOrange" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
