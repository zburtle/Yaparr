<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.DownloadDialog"
        Title="Getting FFmpeg" SizeToContent="Height" Width="420" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Downloading..." />
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
