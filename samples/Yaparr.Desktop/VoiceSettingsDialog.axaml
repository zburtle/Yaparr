<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.VoiceSettingsDialog"
        Title="Voice settings" Icon="avares://Yaparr.Desktop/Assets/yaparr.png" SizeToContent="Height" Width="440" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="4">
        <TextBlock Text="Microphone" FontWeight="SemiBold" />
        <ComboBox x:Name="InputBox" HorizontalAlignment="Stretch" />
        <TextBlock Text="Speakers or headphones" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ComboBox x:Name="OutputBox" HorizontalAlignment="Stretch" />
        <TextBlock Text="Volume" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Slider x:Name="OutputVolumeBox" Minimum="0" Maximum="300" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="100% is as received; higher makes everyone louder." />
        <CheckBox x:Name="EchoBox" Margin="0,10,0,0" Content="Echo cancellation (others do not hear themselves through your speakers)" />
        <TextBlock Text="Noise suppression" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ComboBox x:Name="NoiseBox" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="ProcessingNote" Classes="muted small" TextWrapping="Wrap"
                   Text="Takes steady noise such as fans and hiss out of your microphone. A headset works best and needs no echo cancellation." />
        <CheckBox x:Name="AlwaysBox" Margin="0,10,0,0" Content="Always send my microphone (no voice activation)" />
        <CheckBox x:Name="PushToTalkBox" Margin="0,4,0,0" Content="Push to talk: send only while I hold a key or mouse button" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
            <Button x:Name="PushToTalkKeyButton" Content="Choose a key…" Click="PushToTalkKey_Click" />
            <TextBlock x:Name="PushToTalkNote" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                       Text="Pick a key you do not type with, such as F13 or Pause, or the middle or a side button of the mouse." />
        </StackPanel>
        <CheckBox x:Name="PushToTalkSoundBox" Margin="24,0,0,0" Content="Play a short tick when the key goes down" />
        <TextBlock Text="Voice activation sensitivity" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Your microphone is sent when its level (the bar) goes above the slider. Move the slider just above the level you see while you are quiet." />
        <Grid Height="22" Margin="0,4,0,0">
            <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" />
        </Grid>
        <Slider x:Name="SensitivityBox" Minimum="1" Maximum="100" />
        <TextBlock x:Name="HintText" Classes="muted small" TextWrapping="Wrap"
                   Text="The bar moves while you are in a voice channel." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Classes="primary" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="70" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
