<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.ShareDialog"
        Title="Share your screen" Icon="avares://Yaparr.Desktop/Assets/yaparr.png" SizeToContent="Height" Width="420" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="4">
        <TextBlock Text="What to share" FontWeight="SemiBold" />
        <ComboBox x:Name="WhatBox" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="WindowsNote" Classes="muted small" TextWrapping="Wrap"
                   Text="A window is shared even when other windows are on top of it. A minimised window stops updating, and one that is resized keeps its shape inside the size it had when you started." />
        <Button x:Name="RefreshButton" Content="Refresh the list of windows" HorizontalAlignment="Left" Margin="0,2,0,0" Click="Refresh_Click" />
        <TextBlock x:Name="QualityLabel" Text="Quality" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="SoundNote" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="The sound is shared too: a window's own sound, or for a monitor everything you hear except Yaparr, so the voice chat is not sent back. Needs Windows 10 version 2004 or newer." />
        <ComboBox x:Name="SoundBox" HorizontalAlignment="Stretch" IsVisible="False" DropDownOpened="SoundBox_DropDownOpened" />
        <TextBlock x:Name="Note" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Everyone in the room can watch. Each viewer passes the picture on to a few others, so a big room does not need a fast connection from you. Higher quality needs a faster upload." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ShareButton" Content="Share" Classes="primary" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" Click="Share_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="70" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
