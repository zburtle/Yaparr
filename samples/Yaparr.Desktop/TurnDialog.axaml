<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.TurnDialog"
        Title="TURN relay" SizeToContent="Height" Width="460" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="4">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="A TURN server relays Yaparr's traffic when two peers cannot connect directly (for example behind symmetric NAT). Messages stay end-to-end signed; the relay only forwards packets." />
        <CheckBox x:Name="EnabledBox" Content="Use a TURN relay" />
        <TextBlock Text="Server (host:port)" Margin="0,4,0,0" />
        <TextBox x:Name="ServerBox" />
        <TextBlock Text="Username" Margin="0,4,0,0" />
        <TextBox x:Name="UserBox" />
        <TextBlock Text="Password / credential" Margin="0,4,0,0" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" />
        <CheckBox x:Name="AlwaysBox" Margin="0,4,0,0" Content="Always relay (otherwise only when behind a NAT that blocks direct connections)" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="Gray" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Classes="primary" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" Click="Save_Click" />
            <Button Content="Close" IsCancel="True" MinWidth="70" HorizontalContentAlignment="Center" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
