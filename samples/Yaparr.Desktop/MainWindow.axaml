<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Yaparr.Desktop"
        x:Class="Yaparr.Desktop.MainWindow"
        Title="Yaparr" Width="960" Height="620" MinWidth="640" MinHeight="400">
    <Window.Styles>
        <Style Selector="Button.side">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="TextBlock.system">
            <Setter Property="Foreground" Value="DimGray" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.missed">
            <Setter Property="Foreground" Value="SlateGray" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.mine">
            <Setter Property="Foreground" Value="SteelBlue" />
        </Style>
        <Style Selector="TextBlock.failed">
            <Setter Property="Foreground" Value="Firebrick" />
        </Style>

        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style Selector="Ellipse.dot.online">
            <Setter Property="Fill" Value="SeaGreen" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="TextBlock.state.online">
            <Setter Property="Foreground" Value="SeaGreen" />
        </Style>
        <Style Selector="TextBlock.state.warn">
            <Setter Property="Foreground" Value="DarkOrange" />
        </Style>
        <Style Selector="TextBlock.person">
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="TextBlock.person.online">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Create private room…" Click="CreateRoom_Click" />
                <MenuItem Header="_Join with invite…" Click="JoinRoom_Click" />
                <Separator />
                <MenuItem Header="Copy my _ID" Click="CopyId_Click" />
                <MenuItem Header="_Import profile…" Click="ImportProfile_Click" />
                <MenuItem Header="_Export profile…" Click="ExportProfile_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Network">
                <MenuItem Header="_VPN…" Click="Vpn_Click" />
                <MenuItem Header="_TURN relay…" Click="Turn_Click" />
                <Separator />
                <MenuItem Header="_Check connection…" Click="CheckNetwork_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates…" Click="CheckUpdates_Click" />
                <MenuItem Header="Open _log file" Click="OpenLog_Click" />
                <Separator />
                <MenuItem Header="_About Yaparr" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="DimGray" />
                <TextBlock x:Name="StatusText" Text="Starting…" Foreground="DimGray" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="230,*,200">
            <DockPanel Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" />
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Content="Copy ID" Margin="6,0,0,0" Click="CopyId_Click"
                                ToolTip.Tip="Copy your peer ID so others can open a direct chat with you" />
                        <TextBlock x:Name="IdText" Foreground="DimGray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Create private room…" Classes="side" Click="CreateRoom_Click" />
                    <Button Content="Join with invite…" Classes="side" Click="JoinRoom_Click" />
                    <Button Content="Direct chat…" Classes="side" Click="DirectChat_Click" />
                </StackPanel>
                <ListBox x:Name="ConversationList" SelectionChanged="ConversationList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ConversationVm">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="ConversationMenu_Opening">
                            <MenuItem Header="_Rename…" Click="RenameRoom_Click" />
                            <MenuItem Header="_Leave room" Click="LeaveRoom_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="InviteButton" DockPanel.Dock="Right" Content="Copy invite" IsVisible="False" Click="CopyInvite_Click" />
                    <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="Create a private room, join one with an invite, or open a direct chat to begin" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="70" Margin="6,0,0,0"
                            HorizontalContentAlignment="Center" IsEnabled="False" Click="Send_Click" />
                    <TextBox x:Name="InputBox" IsEnabled="False" KeyDown="InputBox_KeyDown" />
                </DockPanel>
                <ListBox x:Name="MessageList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:MessageVm">
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                       Classes.system="{Binding IsSystem}" Classes.missed="{Binding IsCatchUp}"
                                       Classes.mine="{Binding IsMine}" Classes.failed="{Binding CanRetry}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="MessageMenu_Opening">
                            <MenuItem Header="_Retry sending" Click="RetryMessage_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2" Margin="8">
                <TextBlock x:Name="PeopleHeader" DockPanel.Dock="Top" Text="People" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="PeopleList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:PeerVm">
                            <DockPanel LastChildFill="True" ToolTip.Tip="{Binding Tip}">
                                <Ellipse DockPanel.Dock="Left" Classes="dot" Classes.online="{Binding Online}"
                                         Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Classes="state" Classes.online="{Binding Online}" Classes.warn="{Binding Warn}"
                                           Margin="8,0,0,0" Text="{Binding StateText}" />
                                <TextBlock Classes="person" Classes.online="{Binding Online}" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
