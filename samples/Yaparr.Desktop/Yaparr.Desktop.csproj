<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaparr.Desktop</RootNamespace>
    <AssemblyName>Yaparr.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>Yaparr</Product>
    <Company>Yaparr</Company>
  </PropertyGroup>

  <!-- The built-in relay. Set TurnServer, TurnUser and TurnCredential as environment variables or build properties,
       or put them in turn.local.props (not committed). Without them the app has no built-in relay. -->
  <Import Project="turn.local.props" Condition="Exists('turn.local.props')" />

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TurnServer</_Parameter1>
      <_Parameter2>$(TurnServer)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TurnUser</_Parameter1>
      <_Parameter2>$(TurnUser)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TurnCredential</_Parameter1>
      <_Parameter2>$(TurnCredential)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaparr\Yaparr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
  </ItemGroup>

</Project>
