<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaparr.Desktop.ScreenViewWindow"
        Title="Shared screen" Width="960" Height="560" MinWidth="320" MinHeight="200"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Background="Black">
        <Image x:Name="Picture" Stretch="Uniform" />
        <TextBlock x:Name="Waiting" Text="Waiting for the first picture..." Foreground="#bbbbbb"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="Info" Grid.Row="1" Foreground="#999999" FontSize="11" Margin="8,4" />
    </Grid>
</Window>
