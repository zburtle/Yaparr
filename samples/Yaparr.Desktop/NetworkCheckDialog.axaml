<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Yaparr.Desktop"
        x:Class="Yaparr.Desktop.NetworkCheckDialog"
        Title="Check connection" Width="520" SizeToContent="Height" MaxHeight="640" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking…" />
        <ItemsControl x:Name="Items" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NetworkCheckRow">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold" Width="22" FontSize="15" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Foreground="DimGray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy report" IsEnabled="False" Click="Copy_Click" />
            <Button x:Name="AgainButton" Content="Check again" IsEnabled="False" Click="Again_Click" />
            <Button Content="Close" IsCancel="True" MinWidth="70" HorizontalContentAlignment="Center" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
