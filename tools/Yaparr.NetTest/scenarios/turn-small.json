{
  "name": "turn-small",
  "description": "The same two machines behind symmetric routers, with a stream small enough (64 kbit/s) to go through the TURN server. It must get through.",
  "durationSeconds": 70,
  "turn": true,
  "nodes": [
    { "name": "sharer", "region": "nyc3", "role": "share", "nat": "symmetric", "args": { "kbps": 64, "fps": 10 } },
    { "name": "viewer", "region": "fra1", "role": "watch", "nat": "symmetric", "startAfterSeconds": 10 }
  ],
  "assertions": [
    { "type": "noOverServer", "nodes": ["viewer"] },
    { "type": "viewersReceive", "value": 0.9 },
    { "type": "attachWithin", "value": 40 }
  ]
}
