  "nodes": [
    { "name": "sharer", "region": "nyc3", "role": "share", "args": { "kbps": 1000, "fps": 15 } },
    { "name": "home", "region": "fra1", "role": "watch", "nat": "cone", "startAfterSeconds": 5 },
    { "name": "forwarded", "region": "lon1", "role": "watch", "nat": "fullcone", "startAfterSeconds": 8 },
    { "name": "symmetric", "region": "sgp1", "role": "watch", "nat": "symmetric", "startAfterSeconds": 11 }
  ],
  "assertions": [
    { "type": "natIs", "nodes": ["symmetric"], "text": "Symmetric" },
    { "type": "relayCapable", "nodes": ["symmetric"], "value": 0 },
    { "type": "viewersReceive", "value": 0.95 },
    { "type": "attachWithin", "value": 40 }
  ]
}
